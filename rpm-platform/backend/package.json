{
  "name": "rpm-backend",
  "version": "2.0.0",
  "description": "Remote Patient Monitoring API — Node/Express, SQLite, JWT auth",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "cross-env RPM_DB=:memory: jest --runInBand",
    "reset-db": "node -e \"require('fs').rmSync('./rpm.db',{force:true});require('./db');console.log('DB reset & reseeded')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
